<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% set compact_index = runs and runs[0].run_page is defined and runs[0].run_page %}
  <style>
    {{ css | safe }}
  </style>
</head>
<body>
  <!--
  DESIGN CONTRACT — The Lab Observation Log (user-locked direction, seed fcdbd2ef)
  THESIS: The report is the researcher's own session log — a preprinted observation
  sheet on the lab bench: ruled fields, carbon ink, rubber stamps. Every claim is an
  observation row pointing at recorded evidence; it refuses the dashboard default.
  OWN-WORLD: bond paper #f7f6f2, carbon ink #1d1f23, form ruling #d9d4c7, manila
  panels #ece7db, review-red stamp ink #bf3a2b, verified-green pen #2f6b4f,
  highlighter amber #a16207, archive brown #7a5230; Public Sans form voice,
  system mono for machine-recorded values; 2px form corners; one sheet shadow.
  STORY: The stakeholder reads the session header, the stamped findings in priority
  order, and verifies any claim through its exhibit tag to the exact evidence.
  FIRST VIEWPORT: Session-record masthead — UXA roundel and document title — above
  the Index sheet: the status stamp, assessment line, and the dashboard cards.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
  finish review, the verdict, DESIGN.md, and every shipping raster carrying its
  provenance.
  -->
  <a class="skip-link" href="#priority-findings">Skip to findings</a>
  <header class="page-header">
    <div>
      <p class="masthead-mark"><span class="masthead-roundel" aria-hidden="true">UXA</span><span>Session record</span></p>
      <h1>{{ title }}</h1>
    </div>
  </header>

  <main>
{% set synthesis_status = synthesis.synthesis_status | default("missing") %}
{% set using_fallback = synthesis.using_fallback if synthesis.using_fallback is defined else true %}
{% set tested_scope = synthesis.tested_scope if synthesis.tested_scope is defined else {} %}
    <p id="evidence-context" class="evidence-context" role="status" hidden></p>

    <nav class="view-rail" aria-label="Report sections">
      <a class="view-tab" href="#view-overview" aria-current="page">Overview</a>
      <a class="view-tab" href="#view-findings">{{ "Recorded signals" if using_fallback else "Findings" }}</a>
      {% if ux_audit %}<a class="view-tab" href="#view-audit">Page findings</a>{% endif %}
      {% if pagespeed %}<a class="view-tab" href="#view-performance">Performance</a>{% endif %}
      <a class="view-tab" href="#view-redesign">Redesign</a>
      <a class="view-tab" href="#view-evidence">Evidence desk</a>
    </nav>

  <div class="view" id="view-overview">

    {% macro status_label(status) -%}
      {%- if status == "accepted" -%}Evidence review complete
      {%- elif status == "no-issues" -%}No supported issues established
      {%- elif status in ["missing", "unavailable", "invalid", "rejected"] -%}Recorded evidence available
      {%- else -%}Evidence review status unavailable
      {%- endif -%}
    {%- endmacro %}

    {% macro confidence_label(confidence) -%}
      {%- if confidence is not none and confidence >= 0.85 -%}High confidence
      {%- elif confidence is not none and confidence >= 0.65 -%}Moderate confidence
      {%- else -%}Limited confidence
      {%- endif -%}
    {%- endmacro %}

    {% macro evidence_action_label(target) -%}
      {%- set surface = target.surface_label if target.surface_label is defined and target.surface_label else "" -%}
      {%- if target.element_id is defined and target.element_id -%}Show on screenshot{% if surface %}: {{ surface }}{% endif %}
      {%- elif target.viewport_id is defined and target.viewport_id -%}View screenshot{% if surface %}: {{ surface }}{% endif %}
      {%- elif target.metric_id is defined and target.metric_id -%}View comparison{% if surface %}: {{ surface }}{% endif %}
      {%- else -%}Open replay
      {%- endif -%}
    {%- endmacro %}

    {% macro render_evidence_refs(finding) -%}
      <ul class="evidence-ref-list">
      {% for ref in finding.evidence_refs %}
        {% set target = finding.evidence_targets[loop.index0] %}
        <li>
          <button
            class="evidence-ref"
            type="button"
            data-evidence-id="{{ ref.evidence_id }}"
            data-evidence-target="{{ target | tojson | forceescape }}"
            aria-label="{{ evidence_action_label(target) }}"
          >{{ evidence_action_label(target) }}</button>
        </li>
      {% else %}
        <li class="empty">No recorded evidence references.</li>
      {% endfor %}
      </ul>
    {%- endmacro %}

    {% macro render_finding(finding) -%}
      <article
        id="finding-{{ finding.finding_id }}"
        class="finding finding-{{ finding.severity }}"
        data-finding-id="{{ finding.finding_id }}"
        data-severity="{{ finding.severity }}"
      >
        <header class="finding-header">
          <div>
            <span class="severity-label severity-{{ finding.severity }}">{{ finding.severity | title }} priority</span>
            <h3>{{ finding.title }}</h3>
          </div>
          <span class="confidence-label">{{ confidence_label(finding.confidence) }}</span>
        </header>
        <div class="finding-grid">
          <div class="finding-field">
            <h4>Issue</h4>
            <p>{{ finding.display_issue | default(finding.issue) }}</p>
          </div>
          <div class="finding-field">
            <h4>Why it matters</h4>
            <p>{{ finding.display_impact | default(finding.impact) }}</p>
          </div>
          <div class="finding-field">
            <h4>Likely root cause</h4>
            <p>{{ finding.display_root_cause | default(finding.root_cause) }}</p>
          </div>
          <div class="finding-field">
            <h4>What to fix</h4>
            <ul class="finding-list">
            {% for fix in finding.display_fixes | default(finding.fixes) %}
              <li>{{ fix }}</li>
            {% else %}
              <li class="empty">No fix was recorded.</li>
            {% endfor %}
            </ul>
          </div>
        </div>
        <div class="finding-meta">
          <div>
            <strong>Affected surfaces</strong>
            <span>{{ finding.affected_surfaces | join(", ") if finding.affected_surfaces else "Not isolated to a named surface." }}</span>
          </div>
          <div>
            <strong>Confidence</strong>
            <span>{{ confidence_label(finding.confidence) }} ({{ "%.0f%%" | format(finding.confidence * 100) }})</span>
          </div>
        </div>
        <details class="finding-verification">
          <summary>Verify evidence</summary>
          <div class="verification-content">
            <div class="verification-block">
              <h4>Evidence references</h4>
              {{ render_evidence_refs(finding) }}
            </div>
            {% if finding.principles %}
            <div class="verification-block">
              <h4>Relevant principles</h4>
              <ul class="finding-list">
              {% for principle in finding.display_principles | default(finding.principles) %}
                <li>{{ principle }}</li>
              {% endfor %}
              </ul>
            </div>
            {% endif %}
            {% if finding.counterevidence %}
            <div class="verification-block">
              <h4>Counterevidence</h4>
              <ul class="finding-list">
              {% for item in finding.counterevidence %}
                {% if item is mapping and item.reference is defined %}
                <li>
                  <button
                    class="evidence-ref"
                    type="button"
                    data-evidence-id="{{ item.reference.evidence_id }}"
                    data-evidence-target="{{ item.target | tojson | forceescape }}"
                    aria-label="{{ evidence_action_label(item.target) }}"
                  >{{ evidence_action_label(item.target) }}</button>
                </li>
                {% else %}
                <li>{{ item }}</li>
                {% endif %}
              {% endfor %}
              </ul>
            </div>
            {% endif %}
            {% if finding.limitations %}
            <div class="verification-block">
              <h4>Limitations</h4>
              <ul class="finding-list">
              {% for limitation in finding.display_limitations | default(finding.limitations) %}
                <li>{{ limitation }}</li>
              {% endfor %}
              </ul>
            </div>
            {% endif %}
            {% if finding.severity_justification or finding.reviewer_notes %}
            <div class="verification-block">
              <h4>Why this priority</h4>
              {% if finding.severity_justification %}
              <p>{{ finding.display_severity_justification | default(finding.severity_justification) }}</p>
              {% endif %}
              {% for note in finding.display_reviewer_notes | default(finding.reviewer_notes) %}
              <p class="muted">{{ note }}</p>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </details>
      </article>
    {%- endmacro %}

    <section
      id="dash-index"
      class="report-section dash-board"
      aria-labelledby="dash-index-title"
      data-synthesis-status="{{ synthesis_status }}"
      data-using-fallback="{{ 'true' if using_fallback else 'false' }}"
    >
      <div class="report-section-heading">
        <div>
          <h2 id="dash-index-title">Index</h2>
        </div>
        <span class="synthesis-status status-{{ synthesis_status }}">{{ status_label(synthesis_status) }}</span>
      </div>
      <p class="summary-assessment">
        {% if using_fallback %}
        {{ synthesis.assessment }}
        {% elif synthesis_status == "no-issues" %}
        No supported UX issues were established in the tested scenarios.
        {% elif synthesis_status == "accepted" %}
        {{ synthesis.assessment }}
        {% elif synthesis_status == "rejected" %}
        No report-synthesis finding was publishable because all candidate findings were rejected.
        {% else %}
        Only recorded evidence is shown; inspect the linked replays below.
        {% endif %}
      </p>
      {% if using_fallback %}
      <p class="fallback-notice">
        {% if synthesis_status == "rejected" %}
        Only recorded evidence is shown because no reviewed finding could be published. Verify each linked replay before changing the website.
        {% elif synthesis_status == "invalid" %}
        Only recorded evidence is shown because the review could not be validated. Verify each linked replay before changing the website.
        {% else %}
        Only recorded evidence is shown. Verify each linked replay before changing the website.
        {% endif %}
      </p>
      {% endif %}
      <div class="dash-grid">
        <a class="dash-card" href="#view-findings">
          <span class="dash-card-tab">{{ "Recorded signals" if using_fallback else "Findings" }}</span>
          <span class="dash-card-count">{{ synthesis.findings | length }}</span>
          {% for finding in synthesis.findings[:2] %}
          <span class="dash-card-line">{{ finding.get("fallback_title", finding.title) }}</span>
          {% else %}
          <span class="dash-card-line empty">No findings recorded.</span>
          {% endfor %}
          <span class="dash-card-cta">{{ "Review signals" if using_fallback else "Review findings" }}</span>
        </a>
        {% if ux_audit %}
        {% set ns_audit = namespace(critical=0, high=0, medium=0, low=0) %}
        {% for url_report in ux_audit.url_reports %}{% for issue in url_report.issues %}
          {% if issue.severity == "critical" %}{% set ns_audit.critical = ns_audit.critical + 1 %}{% endif %}
          {% if issue.severity == "high" %}{% set ns_audit.high = ns_audit.high + 1 %}{% endif %}
          {% if issue.severity == "medium" %}{% set ns_audit.medium = ns_audit.medium + 1 %}{% endif %}
          {% if issue.severity in ("low", "info") %}{% set ns_audit.low = ns_audit.low + 1 %}{% endif %}
        {% endfor %}{% endfor %}
        <a class="dash-card" href="#view-audit">
          <span class="dash-card-tab">Page findings</span>
          <span class="dash-card-count">{{ ux_audit.total_issues }}</span>
          <span class="dash-card-severities">
            {% if ns_audit.critical %}<span class="severity-label severity-critical">{{ ns_audit.critical }} critical</span>{% endif %}
            {% if ns_audit.high %}<span class="severity-label severity-high">{{ ns_audit.high }} high</span>{% endif %}
            {% if ns_audit.medium %}<span class="severity-label severity-medium">{{ ns_audit.medium }} medium</span>{% endif %}
            {% if ns_audit.low %}<span class="severity-label severity-low">{{ ns_audit.low }} low</span>{% endif %}
          </span>
          <span class="dash-card-line">Deterministic checks against each start URL — recorded page facts, not simulated-user findings.</span>
          <span class="dash-card-cta">Open page findings</span>
        </a>
        {% endif %}
        {% if pagespeed %}
        <a class="dash-card" href="#view-performance">
          <span class="dash-card-tab">Performance</span>
          <span class="dash-card-tiles">
          {% set ns_psi = namespace(found=false) %}
          {% for url_report in pagespeed.url_reports %}{% if not ns_psi.found %}{% for strategy_name, strategy in url_report.strategies.items() %}{% if strategy.status == "ok" and strategy.categories and not ns_psi.found %}
            {% for category in strategy.categories[:4] %}
            <span class="psi-tile psi-score-{{ 'good' if category.score is not none and category.score >= 0.9 else ('ok' if category.score is not none and category.score >= 0.5 else 'bad') }}">
              <span class="psi-tile-score">{{ category.score_percent }}</span>
              <span class="psi-tile-label">{{ category.title }}</span>
            </span>
            {% endfor %}
            {% set ns_psi.found = true %}
          {% endif %}{% endfor %}{% endif %}{% endfor %}
          </span>
          <span class="dash-card-line">Lighthouse results per strategy, verbatim from the same API as pagespeed.web.dev.</span>
          <span class="dash-card-cta">Open performance</span>
        </a>
        {% endif %}
        <a class="dash-card" href="#view-evidence">
          <span class="dash-card-tab">Evidence desk</span>
          <span class="dash-card-count">{{ tested_scope.get("run_ids", []) | length }}</span>
          <span class="dash-card-chips">
            {% for item in evidence_summary %}
            <span class="evidence-chip evidence-{{ item.evidence_class }}">{{ item.evidence_class }} <strong>{{ item.count }}</strong></span>
            {% endfor %}
          </span>
          <span class="dash-card-line">{{ failure_rows | length }} failed run{{ "s" if failure_rows | length != 1 }} · comparison table, aggregates, gates, provider methods, and the replay workspace.</span>
          <span class="dash-card-cta">Open evidence desk</span>
        </a>
      </div>
    </section>
  </div>

  {% if ux_audit %}<div class="view" id="view-audit" hidden>

    <section
      id="ux-audit"
      class="report-section ux-audit"
      aria-labelledby="ux-audit-title"
    >
      <div class="report-section-heading">
        <div>
          <h2 id="ux-audit-title">Static &amp; visual page findings</h2>
        </div>
        <span class="finding-count">{{ ux_audit.total_issues }} issue{{ "s" if ux_audit.total_issues != 1 else "" }}</span>
      </div>
      <p class="summary-assessment">
        Deterministic checks (GEO, meta/semantic HTML, performance, accessibility,
        imagery, visual UI fundamentals, and the 27-rule AI-slop fingerprint with
        the 9 copy-axis tells) run against each application start URL. These are recorded page
        facts, not simulated-user findings.
      </p>
      {% for url_report in ux_audit.url_reports %}
      <div class="ux-audit-url">
        <h3 class="ux-audit-url-label">{{ url_report.url }}</h3>
        {% if url_report.slop %}
        <div class="slop-card slop-{{ url_report.slop.tier | lower }}">
          <div class="slop-card-head">
            <div class="slop-score">
              <span class="slop-score-number">{{ url_report.slop.score }}</span>
              <span class="slop-score-max">/100</span>
            </div>
            <div class="slop-meta">
              <span class="slop-tier slop-tier-{{ url_report.slop.tier | lower }}">{{ url_report.slop.tier }}</span>
              <span class="slop-grade">Grade {{ url_report.slop.grade }}</span>
              <span class="slop-count">{{ url_report.slop.patternsFlagged }}/{{ url_report.slop.patternsTotal }} design patterns triggered</span>
              {% if url_report.slop.unifiedScore is not none %}
              <span class="slop-unified">Unified (design + copy): {{ url_report.slop.unifiedScore }}/100 · {{ url_report.slop.unifiedTier }}</span>
              {% endif %}
            </div>
            {% if url_report.slop.verdict %}
            <p class="slop-verdict">{{ url_report.slop.verdict }}</p>
            {% endif %}
          </div>
          <details class="slop-patterns">
            <summary>Triggered patterns ({{ url_report.slop.patternsFlagged }})</summary>
            <ul class="slop-pattern-list">
              {% for pattern in url_report.slop.patterns %}
              {% if pattern.triggered %}
              <li class="slop-pattern slop-pattern-{{ pattern.category }}">
                <span class="slop-pattern-weight">+{{ pattern.weight }}</span>
                <strong>{{ pattern.label }}</strong>
                <code class="slop-pattern-id">{{ pattern.id }}</code>
                {% if pattern.evidence %}
                <details class="slop-evidence">
                  <summary>Evidence</summary>
                  <pre class="slop-evidence-data">{{ pattern.evidence | tojson(indent=2) }}</pre>
                </details>
                {% endif %}
              </li>
              {% endif %}
              {% endfor %}
            </ul>
            {% if url_report.slop['copy'] and url_report.slop['copy'].score is not none %}
            <div class="slop-copy">
              <h4>Copy axis · {{ url_report.slop['copy'].tier }} · {{ url_report.slop['copy'].score }}/100 ({{ url_report.slop['copy'].patternsFlagged }}/{{ url_report.slop['copy'].patternsTotal }})</h4>
              <ul class="slop-pattern-list">
                {% for pattern in url_report.slop['copy'].patterns %}
                {% if pattern.triggered %}
                <li class="slop-pattern slop-pattern-copy">
                  <span class="slop-pattern-weight">+{{ pattern.weight }}</span>
                  <strong>{{ pattern.label }}</strong>
                  {% if pattern.evidence %}
                  <details class="slop-evidence">
                    <summary>Evidence</summary>
                    <pre class="slop-evidence-data">{{ pattern.evidence | tojson(indent=2) }}</pre>
                  </details>
                  {% endif %}
                </li>
                {% endif %}
                {% endfor %}
              </ul>
            </div>
            {% endif %}
          </details>
        </div>
        {% endif %}
        {% if url_report.issues %}
        <ul class="ux-audit-issues">
          {% set severity_order = ["critical", "high", "medium", "low", "info"] %}
          {% for audit_severity in severity_order %}
          {% for issue in url_report.issues if issue.severity == audit_severity %}
          <li class="ux-audit-issue severity-{{ issue.severity }}">
            <div class="ux-audit-issue-header">
              <span class="severity-label severity-{{ issue.severity }}">{{ issue.severity | title }}</span>
              <strong>{{ issue.title }}</strong>
              <span class="ux-audit-category">{{ issue.category }}</span>
              {% if issue.evidence.get('element_selector') or issue.evidence.get('element_selectors') %}
              <span class="ux-audit-elements-hint" title="{{ ((issue.evidence.get('element_selectors') or []) | join(', ')) if issue.evidence.get('element_selectors') else issue.evidence.get('element_selector') }}">{{ (issue.evidence.get('element_selectors')[0] if issue.evidence.get('element_selectors') else issue.evidence.get('element_selector')) | truncate(48) }}</span>
              {% endif %}
            </div>
            <details class="ux-audit-evidence">
              <summary>Evidence</summary>
              {% if issue.evidence.get('element_selectors') or issue.evidence.get('element_selector') or issue.evidence.get('element_xpaths') or issue.evidence.get('element_xpath') %}
              <div class="ux-audit-element-info">
                <h4>Offending element(s)</h4>
                {% if issue.evidence.get('element_selectors') %}
                  {% for sel in issue.evidence.get('element_selectors') %}
                  <div class="ux-audit-selector-row">
                    <span class="ux-audit-label">Selector:</span>
                    <code class="ux-audit-selector" title="{{ sel }}">{{ sel }}</code>
                  </div>
                  {% endfor %}
                {% elif issue.evidence.get('element_selector') %}
                  <div class="ux-audit-selector-row">
                    <span class="ux-audit-label">Selector:</span>
                    <code class="ux-audit-selector">{{ issue.evidence.get('element_selector') }}</code>
                  </div>
                {% endif %}
                {% if issue.evidence.get('element_xpaths') %}
                  {% for xp in issue.evidence.get('element_xpaths') %}
                  <div class="ux-audit-xpath-row">
                    <span class="ux-audit-label">XPath:</span>
                    <code class="ux-audit-xpath" title="{{ xp }}">{{ xp }}</code>
                  </div>
                  {% endfor %}
                {% elif issue.evidence.get('element_xpath') %}
                  <div class="ux-audit-xpath-row">
                    <span class="ux-audit-label">XPath:</span>
                    <code class="ux-audit-xpath">{{ issue.evidence.get('element_xpath') }}</code>
                  </div>
                {% endif %}
                {% if issue.evidence.get('element_boxes') %}
                <div class="ux-audit-boxes">
                  <span class="ux-audit-label">Bounding boxes:</span>
                  {% for box in issue.evidence.get('element_boxes') %}
                    <code class="ux-audit-box">[x:{{ box.x }}, y:{{ box.y }}, w:{{ box.w }}, h:{{ box.h }}]</code>
                  {% endfor %}
                </div>
                {% endif %}
              </div>
              {% endif %}
              {% if issue.evidence.get('combined_screenshots') or issue.evidence.get('combined_screenshot') or issue.evidence.get('element_screenshots') %}
              <div class="ux-audit-screenshots">
                {% for cshot in issue.evidence.get('combined_screenshots', []) %}
                  <figure class="ux-audit-figure">
                    <img src="{{ cshot }}" alt="Annotated elements — red outlines show offending element(s)" class="ux-audit-screenshot" loading="lazy">
                    <figcaption>Annotated view {{ loop.index }} — red outlines mark the offending element(s) in context</figcaption>
                  </figure>
                {% endfor %}
                {% if issue.evidence.get('combined_screenshot') and not issue.evidence.get('combined_screenshots') %}
                  <figure class="ux-audit-figure">
                    <img src="{{ issue.evidence.get('combined_screenshot') }}" alt="Annotated elements — red outlines show offending element(s)" class="ux-audit-screenshot" loading="lazy">
                    <figcaption>Annotated view — red outlines mark the offending element(s) in context</figcaption>
                  </figure>
                {% endif %}
                {% if issue.evidence.get('element_screenshots') %}
                  {% for shot in issue.evidence.get('element_screenshots') %}
                  <figure class="ux-audit-figure">
                    <img src="{{ shot }}" alt="Cropped view of offending element with red outline" class="ux-audit-screenshot" loading="lazy">
                    <figcaption>Cropped element {{ loop.index }}{% if issue.evidence.get('element_selectors') and loop.index0 < issue.evidence.get('element_selectors')|length %} — <code>{{ issue.evidence.get('element_selectors')[loop.index0] }}</code>{% endif %} — red outline marks exact bounds</figcaption>
                  </figure>
                  {% endfor %}
                {% endif %}
              </div>
              {% endif %}
              <pre class="ux-audit-evidence-data">{{ issue.evidence | tojson(indent=2) }}</pre>
            </details>
          </li>
          {% endfor %}
          {% endfor %}
        </ul>
        {% else %}
        <p class="ux-audit-clean">No static page issues found for this URL.</p>
        {% endif %}
      </div>
      {% endfor %}
    </section>
  </div>
  {% endif %}

  {% if pagespeed %}<div class="view" id="view-performance" hidden>
    <section
      id="pagespeed"
      class="report-section pagespeed"
      aria-labelledby="pagespeed-title"
    >
      <div class="report-section-heading">
        <div>
          <h2 id="pagespeed-title">Lighthouse performance reports</h2>
        </div>
        <span class="finding-count">{{ pagespeed.ok_strategy_count }} report{{ "s" if pagespeed.ok_strategy_count != 1 else "" }}</span>
      </div>
      <p class="summary-assessment">
        Complete PageSpeed Insights results for each application start URL,
        fetched from the same API that powers pagespeed.web.dev. Category
        scores, per-audit pass/fail results, and opportunity savings are
        taken verbatim from the API response; the audit pass threshold is
        the pagespeed.web.dev convention (score &lt; 0.9 = failed).
        "View saved report" opens an offline replica of this exact
        recorded analysis with identical numbers; "Re-run on
        pagespeed.web.dev" starts a new Lighthouse run, and scores vary
        between runs.
      </p>
      {% for url_report in pagespeed.url_reports %}
      <div class="psi-url">
        <h3 class="psi-url-label">
          {{ url_report.url }}
          {% if url_report.pagespeed_web_url %}
          <a
            class="psi-web-link psi-web-link-saved"
            href="pagespeed-report.html"
            title="Offline replica of the recorded analysis — identical numbers to this tab"
          >View saved report</a>
          {% endif %}
          {% if url_report.pagespeed_web_fresh_url %}
          <a
            class="psi-web-link psi-web-link-fresh"
            href="{{ url_report.pagespeed_web_fresh_url }}"
            target="_blank"
            rel="noopener noreferrer"
            title="Run a fresh analysis for this URL on pagespeed.web.dev — a new Lighthouse run, scores will vary"
          >Re-run on pagespeed.web.dev</a>
          {% endif %}
        </h3>
        {% if url_report.error %}
        <p class="psi-error">Report unavailable: {{ url_report.error }}</p>
        {% endif %}
        {% if not url_report.strategies %}
        <p class="ux-audit-clean">No PageSpeed reports could be fetched for this URL.</p>
        {% endif %}
        {% for strategy_name, strategy in url_report.strategies.items() %}
        <div class="psi-strategy psi-strategy-{{ strategy.status }}">
          <h4 class="psi-strategy-label">{{ strategy_name | title }} strategy</h4>
          {% if strategy.status != "ok" %}
          <p class="psi-error">Unavailable: {{ strategy.error or "no error detail recorded" }}</p>
          {% if strategy.error_code %}<p class="psi-error-detail"><code>{{ strategy.error_code }}</code></p>{% endif %}
          {% if strategy.error_code and "FAILED_DOCUMENT_REQUEST" in strategy.error_code %}<p class="psi-error-help">Lighthouse couldn't load this URL (government portal, likely blocking automated audits or slow ASPX). The local <code>ux-audit</code> and live-page checks in this report still ran — use the link above to retry on pagespeed.web.dev directly.</p>{% endif %}
          {% else %}
          <p class="psi-meta">
            Lighthouse {{ strategy.lighthouse_version }}
            {% if strategy.fetched_at %}· fetched {{ strategy.fetched_at }}{% endif %}
            {% if strategy.from_cache %}· served from cache{% endif %}
            {% if strategy.final_url and strategy.final_url != url_report.url %}· final URL {{ strategy.final_url }}{% endif %}
          </p>
          {% if strategy.field_data %}
          <div class="psi-field">
            <span class="psi-field-label">Field data (CrUX):</span>
            <span class="psi-field-overall">{{ strategy.field_data.overall_category }}</span>
            {% for metric_id, metric in strategy.field_data.metrics.items() %}
            <span class="psi-field-metric">{{ metric_id }} {{ metric.percentile }}{% if metric.category %} ({{ metric.category }}){% endif %}</span>
            {% endfor %}
          </div>
          {% endif %}
          {% if strategy.categories %}
          <div class="psi-categories">
            {% for category in strategy.categories %}
            <div class="psi-category psi-score-{{ 'good' if category.score is not none and category.score >= 0.9 else ('ok' if category.score is not none and category.score >= 0.5 else 'bad') }}">
              <span class="psi-category-title">{{ category.title }}</span>
              <span class="psi-category-score">{{ category.score_percent }}</span>
              {% if category.display_value %}
              <span class="psi-category-value">{{ category.display_value }}</span>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
          <p class="psi-totals">
            {{ strategy.audits.totals.failed }} failed ·
            {{ strategy.audits.totals.passed }} passed ·
            {{ strategy.audits.totals.not_applicable }} not applicable ·
            {{ strategy.audits.totals.manual }} manual ·
            {{ strategy.audits.totals.informative }} informative ·
            {{ strategy.audits.totals.error }} error
          </p>
          {% if strategy.audits.failed %}
          <details class="psi-audit-bucket" open>
            <summary>Failed audits ({{ strategy.audits.failed | length }})</summary>
            <ul class="psi-audit-list">
              {% for audit in strategy.audits.failed %}
              <li class="psi-audit psi-audit-failed">
                <div class="psi-audit-head">
                  <span class="psi-audit-score">{{ audit.score_percent if audit.score is not none else "—" }}</span>
                  <strong>{{ audit.title }}</strong>
                  {% if audit.display_value %}<span class="psi-audit-value">{{ audit.display_value }}</span>{% endif %}
                  <code class="psi-audit-id">{{ audit.id }}</code>
                </div>
                {% if audit.description %}
                <details class="psi-audit-detail">
                  <summary>Detail</summary>
                  <p class="psi-audit-description">{{ audit.description }}</p>
                </details>
                {% endif %}
              </li>
              {% endfor %}
            </ul>
          </details>
          {% endif %}
          {% if strategy.opportunities %}
          <details class="psi-audit-bucket" open>
            <summary>Opportunities ({{ strategy.opportunities | length }})</summary>
            <ul class="psi-opportunity-list">
              {% for opportunity in strategy.opportunities %}
              <li class="psi-opportunity">
                <div class="psi-opportunity-head">
                  <strong>{{ opportunity.title }}</strong>
                  {% if opportunity.display_value %}<span class="psi-audit-value">{{ opportunity.display_value }}</span>{% endif %}
                  {% if opportunity.savings_ms is not none %}<span class="psi-savings">~{{ opportunity.savings_ms }} ms</span>{% endif %}
                  {% if opportunity.savings_bytes is not none %}<span class="psi-savings">~{{ opportunity.savings_bytes }} bytes</span>{% endif %}
                  <code class="psi-audit-id">{{ opportunity.id }}</code>
                </div>
                {% if opportunity['items'] %}
                <details class="psi-audit-detail">
                  <summary>{{ opportunity['items'] | length }} item(s)</summary>
                  <ul class="psi-opportunity-items">
                    {% for item in opportunity['items'] %}
                    <li>
                      {% if item.get('url') %}<code class="psi-item-url">{{ item.get('url') }}</code>{% endif %}
                      {% if item.get('wastedBytes') is not none %} · ~{{ item.get('wastedBytes') }} bytes wasted{% endif %}
                      {% if item.get('wastedMs') is not none %} · ~{{ item.get('wastedMs') }} ms wasted{% endif %}
                      {% if item.get('totalBytes') is not none %} · {{ item.get('totalBytes') }} bytes total{% endif %}
                      {% if item.get('responseTime') is not none %} · {{ item.get('responseTime') }} ms response{% endif %}
                    </li>
                    {% endfor %}
                  </ul>
                </details>
                {% endif %}
              </li>
              {% endfor %}
            </ul>
          </details>
          {% endif %}
          {% if strategy.metric_savings %}
          <details class="psi-audit-bucket">
            <summary>Metric savings ({{ strategy.metric_savings | length }})</summary>
            <ul class="psi-opportunity-list">
              {% for opportunity in strategy.metric_savings %}
              <li class="psi-opportunity">
                <div class="psi-opportunity-head">
                  <strong>{{ opportunity.title }}</strong>
                  {% if opportunity.display_value %}<span class="psi-audit-value">{{ opportunity.display_value }}</span>{% endif %}
                  {% if opportunity.savings_ms is not none %}<span class="psi-savings">~{{ opportunity.savings_ms }} ms</span>{% endif %}
                  {% if opportunity.savings_bytes is not none %}<span class="psi-savings">~{{ opportunity.savings_bytes }} bytes</span>{% endif %}
                  <code class="psi-audit-id">{{ opportunity.id }}</code>
                </div>
              </li>
              {% endfor %}
            </ul>
          </details>
          {% endif %}
          {% set psi_buckets = {"Passed": strategy.audits.passed, "Not applicable": strategy.audits.not_applicable, "Manual": strategy.audits.manual, "Informative": strategy.audits.informative, "Error": strategy.audits.error} %}
          {% for bucket_label, bucket_audits in psi_buckets.items() %}
          {% if bucket_audits %}
          <details class="psi-audit-bucket">
            <summary>{{ bucket_label }} ({{ bucket_audits | length }})</summary>
            <ul class="psi-audit-list">
              {% for audit in bucket_audits %}
              <li class="psi-audit">
                <div class="psi-audit-head">
                  <span class="psi-audit-score">{{ audit.score_percent if audit.score is not none else "—" }}</span>
                  <strong>{{ audit.title }}</strong>
                  {% if audit.display_value %}<span class="psi-audit-value">{{ audit.display_value }}</span>{% endif %}
                  <code class="psi-audit-id">{{ audit.id }}</code>
                </div>
              </li>
              {% endfor %}
            </ul>
          </details>
          {% endif %}
          {% endfor %}
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </section>
  </div>
  {% endif %}

  <div class="view" id="view-redesign" hidden>
    <section
      id="redesign-proposals"
      class="report-section ux-redesign"
      aria-labelledby="redesign-title"
      data-redesign-state="{{ redesign.state }}"
    >
      <div class="report-section-heading">
        <div>
          <h2 id="redesign-title">Design proposals</h2>
        </div>
        <span class="redesign-state redesign-state-{{ redesign.state }}">{{ redesign.state_label }}</span>
      </div>
      <p class="summary-assessment">
        Design proposals are model estimates produced from the captured pages and
        the published redesign principles — they are not run-evidence findings and
        they carry no verification status. Impact and effort are model estimates
        (Flag-pair ink), not measured values.
      </p>
      {% if redesign.capture_truncated %}
      <p class="redesign-capture-limitation fallback-notice">
        Model estimates cover only the first {{ redesign.capture_note_height }}px of each
        page; content below the capture limit was not captured and was not shown to
        the model.
      </p>
      {% endif %}
      {% if redesign.state == "accepted" and redesign.proposals %}
      {% if redesign.page_understanding %}
      <div class="redesign-understanding">
        {% for page in redesign.page_understanding %}
        <div class="redesign-understanding-page">
          <h3 class="redesign-understanding-url">{{ page.url }}</h3>
          <p class="redesign-understanding-intent"><strong>Intent:</strong> {{ page.intent }}</p>
          <p class="redesign-understanding-audience"><strong>Inferred audience (model inference):</strong> {{ page.audience_inference }}</p>
          <p class="redesign-understanding-relationships"><strong>Section relationships:</strong> {{ page.section_relationships }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      <div class="redesign-filters" data-redesign-filters>
        <div class="redesign-filter-group" role="group" aria-label="Filter by category">
          <span class="redesign-filter-label">Category:</span>
          {% for category in redesign.categories %}
          <button type="button" class="redesign-filter-chip" data-filter-category="{{ category }}">{{ category }}</button>
          {% endfor %}
        </div>
        <div class="redesign-filter-group" role="group" aria-label="Filter by page">
          <span class="redesign-filter-label">Page:</span>
          {% for page_url in redesign.page_urls %}
          <button type="button" class="redesign-filter-chip" data-filter-page="{{ page_url }}">{{ page_url }}</button>
          {% endfor %}
        </div>
      </div>
      <div class="redesign-proposal-list">
        {% for proposal in redesign.proposals %}
        <article class="proposal-card" data-category="{{ proposal.category }}" data-page-url="{{ proposal.page_url }}">
          <div class="proposal-card-header">
            <span class="proposal-impact-effort">Impact: {{ proposal.impact }} · Effort: {{ proposal.effort }}</span>
            <span class="proposal-category">{{ proposal.category }}</span>
          </div>
          <h3 class="proposal-title">{{ proposal.title }}</h3>
          <p class="proposal-page">{{ proposal.page_url }}</p>
          <div class="proposal-grid">
            <div class="proposal-field"><h4>Observation</h4><p>{{ proposal.observation }}</p></div>
            <div class="proposal-field"><h4>Rationale</h4><p>{{ proposal.rationale }}</p></div>
            <div class="proposal-field"><h4>Change</h4><p>{{ proposal.change }}</p></div>
            <div class="proposal-field">
              <h4>Principles</h4>
              <p>{{ proposal.principle_ids | join(", ") }}</p>
            </div>
          </div>
          {% if proposal.deliberate_choice_check %}
          <p class="proposal-deliberate">Deliberate-choice note: {{ proposal.deliberate_choice_check.pattern }} — {{ proposal.deliberate_choice_check.rationale }}</p>
          {% endif %}
          {% if proposal.also_affects %}
          <p class="proposal-also-affects"><strong>Also affects:</strong> {{ proposal.also_affects | join(", ") }}</p>
          {% endif %}
        </article>
        {% endfor %}
      </div>
      {% if redesign.consistency_notes %}
      <div class="redesign-consistency-notes">
        <h3>Cross-page consistency notes</h3>
        <ul class="redesign-consistency-list">
          {% for note in redesign.consistency_notes %}
          <li>{{ note }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% if redesign.pack_version %}
      <p class="redesign-pack-version">Principle pack version: {{ redesign.pack_version }}</p>
      {% endif %}
      {% else %}
      <div class="redesign-placeholder fallback-notice">
        <p>{{ redesign.placeholder_text }}</p>
        {% if redesign.reasons %}
        <ul class="redesign-reasons">
          {% for reason in redesign.reasons %}
          <li>{{ reason }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% if redesign.consistency_notes %}
      <div class="redesign-consistency-notes">
        <h3>Cross-page consistency notes</h3>
        <ul class="redesign-consistency-list">
          {% for note in redesign.consistency_notes %}
          <li>{{ note }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% endif %}
    </section>
  </div>

  <div class="view" id="view-findings" hidden>

        <section id="priority-findings" class="report-section" aria-labelledby="priority-findings-title">
      <div class="report-section-heading">
        <div>
          <h2 id="priority-findings-title">{{ "Recorded signals requiring manual review" if using_fallback else "Priority findings" }}</h2>
        </div>
        <span class="finding-count">{{ synthesis.findings | length }} {{ "recorded" if using_fallback else "accepted" }}</span>
      </div>
      {% if synthesis.findings %}
        {% if using_fallback %}
          <details class="fallback-details" open>
            <summary>Recorded signal{{ "s" if synthesis.findings | length != 1 }} — verify each replay before acting on it. Low confidence, requires human check.</summary>
          {% for finding in synthesis.findings %}
          {% set fallback_viewport_ids = finding.get("viewport_ids", []) %}
          {% set fallback_element_ids = finding.get("element_ids", []) %}
          <article
            id="finding-{{ finding.finding_id }}"
            class="finding finding-fallback"
            data-finding-id="{{ finding.finding_id }}"
          >
            <header class="finding-header">
              <div>
                <span class="recorded-signal-label">Recorded signal</span>
                <h3>{{ finding.get("fallback_title", finding.title) }}</h3>
              </div>
              <span class="confidence-label">Recorded evidence</span>
            </header>
            <div class="finding-context" data-fallback-context="true">
              <div><strong>Scenario</strong><span>{{ finding.fallback_context.scenario }}</span></div>
              <div><strong>Persona</strong><span>{{ finding.fallback_context.persona }}</span></div>
              <div><strong>Goal</strong><span>{{ finding.fallback_context.goal }}</span></div>
              <div><strong>Version</strong><span>{{ finding.fallback_context.version }}</span></div>
              <div><strong>Target</strong><span>{{ finding.fallback_context.target }}</span></div>
              <div><strong>Action</strong><span>{{ finding.fallback_context.action }}</span></div>
              <div><strong>Outcome</strong><span>{{ finding.fallback_context.outcome }}</span></div>
              <div><strong>Verification</strong><span>{{ finding.fallback_context.verification }}</span></div>
            </div>
            <div class="finding-grid">
              <div class="finding-field">
                <h4>Recorded signal</h4>
                <p>{{ finding.get("fallback_issue") }}</p>
              </div>
              <div class="finding-field">
                <h4>Recorded context</h4>
                <p>{{ finding.get("fallback_impact") }}</p>
              </div>
              <div class="finding-field">
                <h4>Recorded cause</h4>
                <p>{{ finding.get("fallback_root_cause") }}</p>
              </div>
              <div class="finding-field">
                <h4>What to change</h4>
                <p>{{ finding.get("fallback_fix") }}</p>
              </div>
            </div>
            <div class="finding-meta">
              <div>
                <strong>Affected surfaces</strong>
                    <span>{{ finding.fallback_context.target }}</span>
              </div>
              <div>
                <strong>Confidence</strong>
                <span>
                  {% if synthesis_status in ["missing", "unavailable"] %}
                  Recorded evidence only.
                  {% elif synthesis_status == "invalid" %}
                  Recorded evidence only.
                  {% else %}
                  Recorded evidence only.
                  {% endif %}
                </span>
              </div>
            </div>
            <details class="finding-verification">
              <summary>Verify evidence</summary>
              <div class="verification-content">
                <div class="verification-block">
                  <h4>Evidence references</h4>
                  <ul class="evidence-ref-list">
                  {% for evidence in finding.get("evidence_refs", []) %}
                    {% set evidence_id = evidence.get("evidence_id", "") %}
                    <li>
                    {% if evidence.get("available") and evidence.get("target") %}
                      <button
                        class="evidence-ref"
                        type="button"
                        data-evidence-id="{{ evidence_id }}"
                        data-evidence-target="{{ evidence.get("target") | tojson | forceescape }}"
                        aria-label="{{ evidence_action_label(evidence.get("target")) }}"
                      >{{ evidence_action_label(evidence.get("target")) }}</button>
                    {% else %}
                      <span class="evidence-ref-unavailable">Evidence unavailable</span>
                    {% endif %}
                    </li>
                  {% else %}
                    <li class="empty">No recorded evidence references.</li>
                  {% endfor %}
                  </ul>
                </div>
                {% if finding.get("limitations") %}
                <div class="verification-block">
                  <h4>What this evidence cannot show</h4>
                  <ul class="finding-list">
                    {% for limitation in finding.get("limitations", []) %}
                    <li>{{ limitation }}</li>
                    {% endfor %}
                  </ul>
                </div>
                {% endif %}
              </div>
            </details>
          </article>
          {% endfor %}
          </details>
        {% else %}
          {% for severity in ("critical", "high", "medium", "low") %}
            {% for finding in synthesis.findings if finding.severity == severity %}
              {{ render_finding(finding) }}
            {% endfor %}
          {% endfor %}
        {% endif %}
      {% else %}
      <p class="empty-conclusion">
        {% if synthesis_status == "no-issues" %}
        No supported UX issues were established in the tested scenarios.
        {% elif synthesis_status == "rejected" %}
        No accepted findings are available because all candidate findings were rejected.
        {% elif using_fallback %}
        No recorded findings are available for this report.
        {% else %}
        No accepted findings are available for this report.
        {% endif %}
      </p>
      {% endif %}
    </section>

    {% if not using_fallback or synthesis.findings %}
    <section id="fix-first" class="report-section" aria-labelledby="fix-first-title">
      <div class="report-section-heading">
        <div>
          <h2 id="fix-first-title">{{ "Check first" if using_fallback else "Fix first" }}</h2>
        </div>
      </div>
      {% if synthesis.findings and not using_fallback %}
      <ol class="fix-first-list">
        {% for severity in ("critical", "high", "medium", "low") %}
          {% for finding in synthesis.findings if finding.severity == severity %}
          <li>
            <a href="#finding-{{ finding.finding_id }}">
              <span class="severity-label severity-{{ finding.severity }}">{{ finding.severity | title }}</span>
              <strong>{{ finding.get("fallback_title", finding.title) }}</strong>
            </a>
                {% if finding.get("fixes") %}
                <span>{{ (finding.display_fixes | default(finding.fixes))[0] }}</span>
                {% elif finding.get("fallback_fix") %}
                <span>{{ finding.get("fallback_fix") }}</span>
            {% endif %}
          </li>
          {% endfor %}
        {% endfor %}
      </ol>
      {% else %}
      <p class="empty-conclusion">
        {% if synthesis_status == "no-issues" %}
        No fix is prioritized because no supported issue was established in the tested scenarios.
        {% elif synthesis_status == "rejected" %}
        No prioritized fix is available because all candidate findings were rejected. Rejected findings are not publishable.
        {% elif using_fallback %}
        No reviewed fix is available; inspect the recorded evidence in the workspace before changing the website.
        {% else %}
        No prioritized fix is available from this report.
        {% endif %}
      </p>
      {% endif %}
    </section>
    {% endif %}
  </div>

  <div class="view" id="view-evidence" hidden>

    <section class="report-section" aria-labelledby="tested-scope-title">
      <div class="report-section-heading">
        <div>
          <h2 id="tested-scope-title">Tested scope</h2>
        </div>
      </div>
      <div class="tested-scope-detail" data-no-issues-scope="true">
        <ul>
        {% for run in runs %}
          <li>
            <a href="{{ run.run_page ~ '?' if run.run_page is defined and run.run_page else '?' }}run={{ run.run_id | urlencode }}#playback-workspace">Open replay</a>:
            {{ run.scenario_label }} / {{ run.version_label }} / {{ run.persona_label }}
          </li>
        {% endfor %}
        </ul>
      </div>
    </section>

    <section id="evidence-workspace" class="report-section evidence-navigation" aria-labelledby="evidence-workspace-title">
      <div class="report-section-heading">
        <div>
          <h2 id="evidence-workspace-title">Evidence workspace</h2>
        </div>
        <span class="muted">Recorded detail and comparison</span>
      </div>
      <p>Use recorded evidence to verify a finding, compare runs, inspect saliency, or replay an interaction.</p>
      <nav class="evidence-nav" aria-label="Evidence sections" data-report-navigation="true">
        <a href="#priority-findings" aria-controls="priority-findings">{{ "Recorded signals" if using_fallback else "Priority findings" }}</a>
        {% if not using_fallback %}
        <a href="#fix-first" aria-controls="fix-first">Fix first</a>
        {% endif %}
        <a href="#evidence-workspace" aria-controls="evidence-workspace">Evidence workspace</a>
        <a href="#comparison-overview" aria-controls="comparison-overview">Comparison table</a>
        {% if focused_acceptance %}
        <a href="#focused-acceptance" aria-controls="focused-acceptance">Saliency gate</a>
        {% endif %}
        {% if provider_comparisons %}
        <a href="#provider-comparison-section" aria-controls="provider-comparison-section">Provider methods</a>
        {% endif %}
        <a href="#playback-workspace" aria-controls="playback-workspace">Replay workspace</a>
      </nav>
      <div id="evidence-detail" class="evidence-detail" tabindex="-1" hidden>
        <h3>Evidence detail</h3>
        <p id="evidence-detail-summary"></p>
        <dl id="evidence-detail-fields" class="field-list"></dl>
      </div>
    </section>

    <section id="comparison-overview" class="section evidence-panel overview-section" aria-labelledby="overview-title" aria-describedby="evidence-workspace-title">
      <div class="section-heading">
        <div>
          <h2 id="overview-title">Comparison overview</h2>
        </div>
        <div class="evidence-summary" aria-label="Evidence classes">
          {% for item in evidence_summary %}
          <span class="evidence-chip evidence-{{ item.evidence_class }}">
            {{ item.evidence_class }} <strong>{{ item.count }}</strong>
          </span>
          {% endfor %}
        </div>
      </div>
      <div class="table-wrap run-table-wrap">
        <table id="comparison-table">
          <thead>
            <tr>
              <th scope="col">Replay</th>
              <th scope="col">Model trial</th>
              <th scope="col">Prominence provider</th>
              <th scope="col">Reproducibility</th>
              <th scope="col">Scenario</th>
              <th scope="col">Version</th>
              <th scope="col">Persona</th>
              <th scope="col">Policy</th>
              <th scope="col">User actions</th>
              <th scope="col">Observations</th>
              <th scope="col">Discovery cost <span class="subvalue">lower is better</span></th>
              <th scope="col">Estimated task time <span class="subvalue">simulated user effort</span></th>
              <th scope="col">Model calls <span class="subvalue">analysis cost</span></th>
              <th scope="col">Analysis latency</th>
              <th scope="col">Tokens</th>
              <th scope="col">Outcome</th>
              <th scope="col">Stage</th>
              <th scope="col">Verification</th>
              <th scope="col">Failure / evaluation reason</th>
              <th scope="col">Gate</th>
            </tr>
          </thead>
          <tbody>
          {% for row in run_rows %}
            <tr class="run-row {{ row.status_class }}" data-run-id="{{ row.run_id }}">
              <td>
                <strong>{{ row.scenario_label }} / {{ row.version_label }}</strong><span class="subvalue">{{ row.persona_label }}</span>
                {% set run_link = namespace(value="") %}
                {% for run in runs if run.run_id == row.run_id %}
                  {% if run.run_page is defined and run.run_page %}{% set run_link.value = run.run_page %}{% endif %}
                {% endfor %}
                <a class="open-run-link" data-open-run="{{ row.run_id }}" href="{{ run_link.value ~ '?' if run_link.value else '?' }}run={{ row.run_id | urlencode }}#playback-workspace">Open replay</a>
              </td>
              <td data-metric="model-trial">{{ row.model_trial }}</td>
              <td data-metric="prominence-provider">{{ row.prominence_provider_id }}</td>
              <td data-metric="reproducibility">{{ row.reproducibility_label }}</td>
              <td>{{ row.scenario_label }}</td>
              <td>{{ row.version_label }}</td>
              <td>{{ row.persona_label }}</td>
              <td>{{ row.policy }}</td>
              <td data-metric="user-actions">{{ row.user_actions }}</td>
              <td data-metric="observations">{{ row.observations }}</td>
              <td data-metric="discovery-cost">{{ row.discovery_cost if row.discovery_cost is not none else "unavailable" }}</td>
              <td data-metric="estimated-task-seconds">{{ row.estimated_task_seconds }}</td>
              <td data-metric="model-calls">{{ row.model_calls }}</td>
              <td data-metric="analysis-latency">{{ row.analysis_latency }}</td>
              <td data-metric="analysis-tokens">{{ row.analysis_tokens }}</td>
              <td><span class="status-pill {{ row.status_class }}">{{ row.status_label }}</span></td>
              <td>{{ row.stage }}</td>
              <td>{{ "verified" if row.verified else "not verified" }}</td>
              <td>{{ row.failure_reason }}</td>
              <td><strong>{{ row.gate_status }}</strong><span class="subvalue">{{ row.gate_reason }}</span></td>
            </tr>
          {% else %}
             <tr><td colspan="20">No run evidence recorded.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="method-note">Estimated task time combines recorded observations and actions. Model processing cost is shown separately.</p>

      <details class="aggregate-details">
        <summary>Aggregate comparison and directional gates</summary>
        <div class="aggregate-grid">
          <div class="table-wrap">
            <table id="aggregate-table">
              <thead><tr><th scope="col">Scenario</th><th scope="col">Persona</th><th scope="col">Policy</th><th scope="col">Prominence provider</th><th scope="col">Model trial</th><th scope="col">Reproducibility</th><th scope="col">Version</th><th scope="col">Runs</th><th scope="col">Verified</th><th scope="col">Discovery cost</th><th scope="col">Task seconds</th><th scope="col">Model calls</th><th scope="col">Latency ms</th><th scope="col">Tokens</th></tr></thead>
              <tbody>
              {% for row in comparison_rows %}
                 <tr data-scenario-id="{{ row.scenario_id }}" data-version-id="{{ row.version_id }}"><td>{{ row.scenario_label }}</td><td>{{ row.persona_label }}</td><td>{{ row.policy }}</td><td data-metric="prominence-provider">{{ row.prominence_provider_id }}</td><td data-metric="model-trial">{{ row.model_trial }}</td><td data-metric="reproducibility">{{ row.reproducibility_label }}</td><td>{{ row.version_label }}</td><td>{{ row.run_count }}</td><td>{{ "%.0f%%" | format(row.verified_rate * 100) }}</td><td>{{ row.discovery_cost if row.discovery_cost is not none else "unavailable" }}</td><td>{{ "%.1f" | format(row.estimated_task_seconds) if row.estimated_task_seconds is not none else "unavailable" }}</td><td>{{ "%.1f" | format(row.model_calls) if row.model_calls is not none else "unavailable" }}</td><td>{{ "%.0f" | format(row.analysis_latency_ms) if row.analysis_latency_ms is not none else "unavailable" }}</td><td>{{ "%.0f" | format(row.analysis_tokens) if row.analysis_tokens is not none else "unavailable" }}</td></tr>
              {% else %}
                 <tr><td colspan="14">Aggregate metrics unavailable.</td></tr>
              {% endfor %}
              </tbody>
            </table>
            {% if aggregate_exclusions %}
            <p class="method-note aggregate-exclusions" id="aggregate-exclusions">
              Excluded from the aggregate comparison:
              {% for exclusion in aggregate_exclusions %}{{ exclusion.scenario_label }} ({{ exclusion.scenario_id }}), {{ exclusion.version_label }} &mdash; {{ exclusion.reason }}{% if not loop.last %}; {% endif %}{% endfor %}.
            </p>
            {% endif %}
          </div>
          <div class="table-wrap">
            <table id="gate-table">
              <thead><tr><th scope="col">Scenario</th><th scope="col">Persona</th><th scope="col">Policy</th><th scope="col">Prominence provider</th><th scope="col">Model trial</th><th scope="col">Reproducibility</th><th scope="col">Seeds</th><th scope="col">Gate</th><th scope="col">Reason</th></tr></thead>
              <tbody>
              {% for row in gate_rows %}
                 <tr><td>{{ row.scenario_label }}</td><td>{{ row.persona_label }}</td><td>{{ row.policy }}</td><td data-metric="prominence-provider">{{ row.prominence_provider_id }}</td><td data-metric="model-trial">{{ row.model_trial }}</td><td data-metric="reproducibility">{{ row.reproducibility_label }}</td><td>{{ row.paired_seed_count }}</td><td>{{ "unavailable" if not row.available else "pass" if row.passed else "fail" }}</td><td>{{ row.reasons | join("; ") if row.reasons else "All directional checks passed" }}</td></tr>
              {% else %}
                 <tr><td colspan="9">Directional gates unavailable.</td></tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </details>
    </section>

    {% if focused_acceptance %}
    <section id="focused-acceptance" class="section evidence-panel focused-acceptance" aria-labelledby="focused-acceptance-title" aria-describedby="evidence-workspace-title">
      <div class="section-heading">
        <div>
          <h2 id="focused-acceptance-title">Focused saliency promotion gate</h2>
        </div>
        <strong>{{ "pass" if focused_acceptance.gate.passed else "fail" }}</strong>
      </div>
      <p>
        Cells: {{ focused_acceptance.gate.cell_count }};
        paired cells: {{ focused_acceptance.gate.paired_cell_count }};
        learned cells: {{ focused_acceptance.gate.learned_cell_count }}.
      </p>
      {% if focused_acceptance.gate.reasons %}
      <p>Gate reasons: {{ focused_acceptance.gate.reasons | join("; ") }}</p>
      {% endif %}
      <div class="table-wrap">
        <table id="focused-operational-evidence">
          <thead><tr><th scope="col">Scenario</th><th scope="col">Version</th><th scope="col">Provider</th><th scope="col">Status</th><th scope="col">Latency ms</th><th scope="col">Peak RSS bytes</th><th scope="col">Sampler</th><th scope="col">Synthetic</th></tr></thead>
          <tbody>
          {% for row in focused_acceptance.cells %}
            <tr><td>{{ row.scenario_id }}</td><td>{{ row.version_id }}</td><td>{{ row.provider_id }}</td><td>{{ row.status }}</td><td>{{ row.latency_ms }}</td><td>{{ row.peak_rss_bytes }}</td><td>{{ row.sampler_provider }}</td><td>{{ "yes" if row.synthetic else "no" }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="method-note"><strong>Operational evidence:</strong> promotion requires measured OS high-water latency and peak RSS. Synthetic fake measurements validate orchestration only.</p>
    </section>
    {% endif %}

    {% if provider_comparisons %}
    <style>
      .provider-comparison-section { padding: 18px; }
      .comparison-note { max-width: 460px; margin: 0; text-align: right; }
      .provider-comparison-toolbar { display: flex; flex-wrap: wrap; gap: 12px; margin: 14px 0; }
      .provider-comparison-toolbar label { display: grid; gap: 3px; color: var(--ink-soft); font-size: .7rem; }
      .provider-comparison-output { min-width: 0; }
      .comparison-cell-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 8px 0 12px; }
      .comparison-cell-heading h3 { margin: 0; font-size: 1rem; }
      .comparison-cell-heading p { margin: 0; }
      .provider-comparison-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
      .provider-card { min-width: 0; padding: 14px 0; border-top: 3px solid var(--stamp); background: transparent; }
      .provider-card-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
      .provider-card-heading h3 { margin: 0; font-size: 1rem; }
      .provider-status { padding: 3px 6px; border: 1px solid var(--rule-strong); border-radius: 2px; color: var(--ink-soft); font-size: .68rem; font-weight: 700; }
      .comparison-block { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--rule); }
      .comparison-block > strong { display: block; margin-bottom: 6px; font-size: .76rem; }
      .provider-heatmap { display: block; width: min(100%, 420px); max-height: 260px; margin: 8px 0; border: 1px solid var(--rule-strong); image-rendering: auto; object-fit: contain; background: var(--carbon); }
      .exact-heatmap { image-rendering: pixelated; }
      .artifact-link { display: inline-block; margin: 2px 0; color: var(--stamp-deep); font-size: .74rem; font-weight: 600; overflow-wrap: anywhere; }
      .comparison-ranking-table { margin-top: 8px; }
      .comparison-path { display: grid; gap: 6px; margin: 0; padding-left: 22px; }
      .comparison-path li { padding-left: 2px; font-size: .73rem; }
      .path-step { max-width: 100%; padding: 4px 6px; border: 1px solid var(--rule-strong); border-radius: 2px; background: var(--paper-raised); color: var(--ink); text-align: left; font-size: .72rem; overflow-wrap: anywhere; }
      .path-step:hover, .path-step:focus-visible { border-color: var(--stamp); background: var(--stamp-soft); }
      .path-status { margin-left: 6px; font-size: .68rem; font-weight: 700; text-transform: uppercase; }
      .path-status-succeeded { color: var(--verified); }
      .path-status-failed { color: var(--stamp); }
      .path-status-recorded { color: var(--ink-soft); }
      .path-error { display: block; margin: 3px 0 0 6px; color: var(--stamp); font-size: .68rem; overflow-wrap: anywhere; }
      @media (max-width: 760px) {
        .provider-comparison-grid { grid-template-columns: 1fr; }
        .comparison-note { text-align: left; }
        .comparison-cell-heading { align-items: flex-start; flex-direction: column; }
      }
    </style>
    <section id="provider-comparison-section" class="section evidence-panel provider-comparison-section" aria-labelledby="provider-comparison-title" aria-describedby="evidence-workspace-title">
      <div class="section-heading">
        <div>
          <h2 id="provider-comparison-title">Provider method comparison</h2>
        </div>
        <p class="method-note comparison-note">Exact persisted heatmaps, prominence rankings, and executed action paths.</p>
      </div>
      <div class="provider-comparison-toolbar">
        <label>Paired cell<select id="provider-comparison-select"></select></label>
        <label>Foveacast duration<select id="provider-comparison-duration"></select></label>
      </div>
      <div id="provider-comparison-output" class="provider-comparison-output"></div>
    </section>
    {% endif %}

    <section class="section evidence-panel workspace-shell" id="playback-workspace" aria-labelledby="workspace-title" aria-describedby="evidence-workspace-title">
      <div class="workspace-heading">
        <div>
          <h2 id="workspace-title">Run workspace</h2>
        </div>
        <div class="selector-group">
          <label>Scenario<select id="scenario-select"><option value="">All scenarios</option></select></label>
          <label>Run<select id="run-select"></select></label>
        </div>
      </div>

      <div class="playback-toolbar" aria-label="Playback controls">
        <button id="restart-playback" class="icon-button" type="button" title="Restart playback" aria-label="Restart playback">&#8635;</button>
        <button id="step-back" class="icon-button" type="button" title="Previous recorded event" aria-label="Previous recorded event">&#8592;</button>
        <button id="play-pause" class="play-button" type="button" aria-pressed="false"><span class="play-icon" aria-hidden="true">&#9654;</span><span id="play-label">Play</span></button>
        <button id="step-forward" class="icon-button" type="button" title="Next recorded event" aria-label="Next recorded event">&#8594;</button>
        <input id="playback-progress" type="range" min="0" max="0" value="0" aria-label="Recorded event progress">
        <output id="playback-position">Step 0 / 0 | time unavailable</output>
      </div>

      <div id="run-status-banner" class="run-status-banner status-untrusted" role="status">Run unavailable.</div>

      <div class="workspace-grid">
        <section class="viewport-pane" aria-labelledby="viewport-title">
          <div class="pane-heading">
            <h3 id="viewport-title">Recorded viewport</h3>
            <span id="viewport-meta">Unavailable</span>
          </div>
          <div id="viewport-stage" class="viewport-stage"></div>
        </section>

        <section class="event-pane" aria-labelledby="event-title">
          <div class="pane-heading">
            <h3 id="event-title">Current event</h3>
            <span id="event-kind">Unavailable</span>
          </div>
          <article id="current-event-card" class="current-event-card"></article>
        </section>

        <aside id="selected-element-evidence" class="element-pane" aria-labelledby="element-title">
           <div class="pane-heading">
             <h3 id="element-title">Element evidence</h3>
             <span id="element-state">Paused</span>
           </div>
           <div id="element-detail"></div>
           <section id="saliency-evidence" class="saliency-evidence" aria-labelledby="saliency-title">
             <div class="pane-heading">
               <h3 id="saliency-title">Saliency evidence</h3>
               <span id="saliency-runtime-label">Unavailable</span>
             </div>
             <div id="saliency-tabs" class="saliency-tabs" role="tablist" aria-label="Saliency duration"></div>
             <div id="saliency-detail" role="tabpanel" tabindex="0"></div>
           </section>
         </aside>
      </div>

      <div class="timeline-rail" aria-labelledby="timeline-title">
        <div class="pane-heading">
          <h3 id="timeline-title">Recorded timeline</h3>
          <span id="timeline-count">0 events</span>
        </div>
        <ol id="timeline-list" class="timeline-list"></ol>
      </div>
    </section>
  </div>

  </main>

  <script type="application/json" id="report-data">{{ report_json | safe }}</script>
  {% if data_sources %}<script type="application/json" id="data-sources">{{ data_sources | tojson }}</script>{% endif %}
  <script>
  {% if compact_index %}
  {{ index_javascript | safe }}
  {% else %}
  {{ javascript | safe }}
  {% endif %}
  </script>
</body>
</html>
