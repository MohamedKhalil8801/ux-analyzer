<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {% set compact_index = runs and runs[0].run_page is defined and runs[0].run_page %}
  <style>
    {% if compact_index %}
    :root{--ink:#1b2426;--muted:#5e6a6d;--wash:#f3f4f1;--line:#d2d9d6;--accent:#0b7180}*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font:14px/1.45 system-ui,sans-serif}a{color:var(--accent)}button:focus-visible,a:focus-visible,summary:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}main,.page-header{width:min(1600px,calc(100% - 28px));margin:0 auto}.page-header{display:flex;justify-content:space-between;gap:24px;padding:24px 0 16px}.section,.report-section{margin-bottom:16px;border:1px solid var(--line);border-radius:6px;background:#fff;overflow-wrap:anywhere}.report-section{padding:20px 0}.report-section-heading{display:flex;justify-content:space-between;gap:18px}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-block:1px solid var(--line)}.summary-item{min-width:0;padding:12px 14px;border-right:1px solid var(--line)}.summary-item span,.finding-header h3,.finding p,.finding li{display:block;overflow-wrap:anywhere}.summary-item span{font-weight:700}.finding{min-width:0;padding:22px 0 24px;border-top:1px solid var(--line)}.finding-header{display:flex;justify-content:space-between;gap:16px}.finding-header h3{margin:7px 0 0;font-size:1.15rem}.severity-label{display:inline-block;padding:3px 7px;border:1px solid currentColor;border-radius:4px;font-size:.68rem;font-weight:800;text-transform:uppercase}.finding-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:18px}.finding-verification{margin-top:18px;border-top:1px solid var(--line)}.evidence-ref-list{margin:0;padding:0;list-style:none}.evidence-ref{max-width:100%;padding:4px 7px;border:1px solid var(--line);border-radius:4px;background:#f8faf8;color:var(--accent);overflow-wrap:anywhere;white-space:normal}.evidence-nav{display:flex;flex-wrap:wrap;gap:8px}.evidence-nav a{display:inline-flex;padding:6px 10px;border:1px solid var(--line);border-radius:4px;background:#f8faf8;text-decoration:none;overflow-wrap:anywhere}@media(max-width:760px){main,.page-header{width:calc(100% - 16px)}.page-header,.report-section-heading{align-items:flex-start;flex-direction:column}.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.summary-item:nth-child(2){border-right:0}.summary-item:nth-child(n+3){border-top:1px solid var(--line)}.finding-header,.finding-grid{grid-template-columns:1fr}.finding-header{display:grid}.evidence-nav a{max-width:100%}}
    {% else %}
    {{ css | safe }}
    {% endif %}
  </style>
</head>
<body>
  <header class="page-header">
    <div>
      <p class="eyebrow">UX Analyzer</p>
      <h1>{{ title }}</h1>
    </div>
    <p class="lede">Recorded experiment evidence. Simulated metrics, not real-user predictions.</p>
  </header>

  <main>
{% set synthesis_status = synthesis.synthesis_status | default("missing") %}
{% set using_fallback = synthesis.using_fallback if synthesis.using_fallback is defined else true %}
{% set tested_scope = synthesis.tested_scope if synthesis.tested_scope is defined else {} %}

    {% macro status_label(status) -%}
      {%- if status == "accepted" -%}Evidence review complete
      {%- elif status == "no-issues" -%}No supported issues established
      {%- elif status in ["missing", "unavailable"] -%}Evidence review unavailable
      {%- elif status == "invalid" -%}Evidence review could not be validated
      {%- elif status == "rejected" -%}Evidence review needs caution
      {%- else -%}Evidence review status unavailable
      {%- endif -%}
    {%- endmacro %}

    {% macro confidence_label(confidence) -%}
      {%- if confidence is not none and confidence >= 0.85 -%}High confidence
      {%- elif confidence is not none and confidence >= 0.65 -%}Moderate confidence
      {%- else -%}Limited confidence
      {%- endif -%}
    {%- endmacro %}

    {% macro render_evidence_refs(finding) -%}
      <ul class="evidence-ref-list">
      {% for ref in finding.evidence_refs %}
        {% set target = finding.evidence_targets[loop.index0] %}
        <li>
          <button
            class="evidence-ref"
            type="button"
            data-evidence-id="{{ ref.evidence_id }}"
            data-evidence-target="{{ target | tojson | forceescape }}"
            aria-label="Open evidence {{ ref.evidence_id }}"
          >{{ ref.evidence_id }}</button>
        </li>
      {% else %}
        <li class="empty">No recorded evidence references.</li>
      {% endfor %}
      </ul>
    {%- endmacro %}

    {% macro render_finding(finding) -%}
      <article
        id="finding-{{ finding.finding_id }}"
        class="finding finding-{{ finding.severity }}"
        data-finding-id="{{ finding.finding_id }}"
        data-severity="{{ finding.severity }}"
      >
        <header class="finding-header">
          <div>
            <span class="severity-label severity-{{ finding.severity }}">{{ finding.severity | title }} priority</span>
            <h3>{{ finding.title }}</h3>
          </div>
          <span class="confidence-label">{{ confidence_label(finding.confidence) }}</span>
        </header>
        <div class="finding-grid">
          <div class="finding-field">
            <h4>Issue</h4>
            <p>{{ finding.issue }}</p>
          </div>
          <div class="finding-field">
            <h4>Why it matters</h4>
            <p>{{ finding.impact }}</p>
          </div>
          <div class="finding-field">
            <h4>Likely root cause</h4>
            <p>{{ finding.root_cause }}</p>
          </div>
          <div class="finding-field">
            <h4>What to fix</h4>
            <ul class="finding-list">
            {% for fix in finding.fixes %}
              <li>{{ fix }}</li>
            {% else %}
              <li class="empty">No fix was recorded.</li>
            {% endfor %}
            </ul>
          </div>
        </div>
        <div class="finding-meta">
          <div>
            <strong>Affected surfaces</strong>
            <span>{{ finding.affected_surfaces | join(", ") if finding.affected_surfaces else "Not isolated to a named surface." }}</span>
          </div>
          <div>
            <strong>Confidence</strong>
            <span>{{ confidence_label(finding.confidence) }} ({{ "%.0f%%" | format(finding.confidence * 100) }})</span>
          </div>
        </div>
        <details class="finding-verification">
          <summary>Verify evidence</summary>
          <div class="verification-content">
            <div class="verification-block">
              <h4>Evidence references</h4>
              {{ render_evidence_refs(finding) }}
            </div>
            <div class="verification-block">
              <h4>Relevant principles</h4>
              <ul class="finding-list">
              {% for principle in finding.principles %}
                <li>{{ principle }}</li>
              {% else %}
                <li class="empty">No principle was recorded.</li>
              {% endfor %}
              </ul>
            </div>
            <div class="verification-block">
              <h4>Counterevidence</h4>
              <ul class="finding-list">
              {% for item in finding.counterevidence %}
                {% if item is mapping and item.reference is defined %}
                <li>
                  <button
                    class="evidence-ref"
                    type="button"
                    data-evidence-id="{{ item.reference.evidence_id }}"
                    data-evidence-target="{{ item.target | tojson | forceescape }}"
                    aria-label="Open counterevidence {{ item.reference.evidence_id }}"
                  >{{ item.reference.evidence_id }}</button>
                </li>
                {% else %}
                <li>{{ item }}</li>
                {% endif %}
              {% else %}
                <li class="empty">No counterevidence was recorded.</li>
              {% endfor %}
              </ul>
            </div>
            <div class="verification-block">
              <h4>Limitations</h4>
              <ul class="finding-list">
              {% for limitation in finding.limitations %}
                <li>{{ limitation }}</li>
              {% else %}
                <li class="empty">No additional limitation was recorded.</li>
              {% endfor %}
              </ul>
            </div>
            <div class="verification-block">
              <h4>Reviewer status</h4>
              <p>{{ finding.reviewer_state | replace("-", " ") | title }}</p>
              {% if finding.severity_justification %}
              <p class="muted">{{ finding.severity_justification }}</p>
              {% endif %}
              {% for note in finding.reviewer_notes %}
              <p class="muted">{{ note }}</p>
              {% endfor %}
            </div>
          </div>
        </details>
      </article>
    {%- endmacro %}

    <section
      id="analysis-summary"
      class="report-section analysis-summary"
      aria-labelledby="analysis-summary-title"
      data-synthesis-status="{{ synthesis_status }}"
      data-using-fallback="{{ 'true' if using_fallback else 'false' }}"
    >
      <div class="report-section-heading">
        <div>
          <p class="eyebrow">At a glance</p>
          <h2 id="analysis-summary-title">Analysis summary</h2>
        </div>
        <span class="synthesis-status status-{{ synthesis_status }}">{{ status_label(synthesis_status) }}</span>
      </div>
      <p class="summary-assessment">
        {% if synthesis_status == "no-issues" %}
        No supported UX issues were established in the tested scenarios.
        {% elif synthesis_status == "accepted" %}
        The tested scenarios show supported issues, with priority and fixes listed below.
        {% elif using_fallback %}
        Recorded findings are shown while the complete evidence review is unavailable.
        {% else %}
        Evidence review is unavailable; inspect recorded run evidence below.
        {% endif %}
      </p>
      <div class="summary-grid">
        <div class="summary-item">
          <strong>{{ "Recorded findings" if using_fallback else "Accepted findings" }}</strong>
          <span>{{ synthesis.findings | length }}</span>
        </div>
        <div class="summary-item">
          <strong>Tested scope</strong>
          <span>{{ tested_scope.get("run_ids", []) | length }} run{% if tested_scope.get("run_ids", []) | length != 1 %}s{% endif %}, {{ tested_scope.get("scenario_ids", []) | length }} scenario{% if tested_scope.get("scenario_ids", []) | length != 1 %}s{% endif %}</span>
        </div>
        <div class="summary-item">
          <strong>Versions and personas</strong>
          <span>{{ tested_scope.get("version_ids", []) | length }} version{% if tested_scope.get("version_ids", []) | length != 1 %}s{% endif %}, {{ tested_scope.get("persona_ids", []) | length }} persona{% if tested_scope.get("persona_ids", []) | length != 1 %}s{% endif %}</span>
        </div>
        <div class="summary-item">
          <strong>Report basis</strong>
          <span>{{ "Recorded findings (backup view)" if using_fallback else "Recorded evidence and reviewed findings" }}</span>
        </div>
      </div>
      {% if using_fallback %}
      <p class="fallback-notice">Backup view in use. Recorded findings remain available while the complete evidence review is unavailable.</p>
      {% endif %}
    </section>

    <section id="priority-findings" class="report-section" aria-labelledby="priority-findings-title">
      <div class="report-section-heading">
        <div>
          <p class="eyebrow">Conclusions</p>
          <h2 id="priority-findings-title">Priority findings</h2>
        </div>
        <span class="finding-count">{{ synthesis.findings | length }} {{ "recorded" if using_fallback else "accepted" }}</span>
      </div>
      {% if synthesis.findings %}
        {% if using_fallback %}
          {% for finding in synthesis.findings %}
          {% set fallback_viewport_ids = finding.get("viewport_ids", []) %}
          {% set fallback_element_ids = finding.get("element_ids", []) %}
          <article
            id="finding-{{ finding.finding_id }}"
            class="finding finding-fallback finding-{{ finding.severity }}"
            data-finding-id="{{ finding.finding_id }}"
            data-severity="{{ finding.severity }}"
          >
            <header class="finding-header">
              <div>
                <span class="severity-label severity-{{ finding.severity }}">{{ finding.severity | title }} priority</span>
                <h3>{{ finding.title }}</h3>
              </div>
              <span class="confidence-label">Recorded finding</span>
            </header>
            <div class="finding-grid">
              <div class="finding-field">
                <h4>Issue</h4>
                <p>{{ finding.get("cause") or finding.get("category") or "Recorded interaction evidence needs review." }}</p>
              </div>
              <div class="finding-field">
                <h4>Why it matters</h4>
                <p>Recorded interaction evidence suggests this area may slow or interrupt the tested task.</p>
              </div>
              <div class="finding-field">
                <h4>Likely root cause</h4>
                <p>{{ finding.get("cause") or "The recorded cause is unavailable." }}</p>
              </div>
              <div class="finding-field">
                <h4>What to fix</h4>
                <ul class="finding-list">
                  <li>Review this area with the recorded evidence before making a product change.</li>
                </ul>
              </div>
            </div>
            <div class="finding-meta">
              <div>
                <strong>Affected surfaces</strong>
                    <span>{{ fallback_element_ids | join(", ") if fallback_element_ids else "Recorded run evidence" }}</span>
              </div>
              <div>
                <strong>Confidence</strong>
                <span>Recorded finding; full evidence review unavailable.</span>
              </div>
            </div>
            <details class="finding-verification">
              <summary>Verify evidence</summary>
              <div class="verification-content">
                <div class="verification-block">
                  <h4>Evidence references</h4>
                  <ul class="evidence-ref-list">
                  {% for evidence in finding.get("evidence_refs", []) %}
                    {% set evidence_id = evidence.get("evidence_id", "") %}
                    <li>
                    {% if evidence.get("available") and evidence.get("target") %}
                      <button
                        class="evidence-ref"
                        type="button"
                        data-evidence-id="{{ evidence_id }}"
                        data-evidence-target="{{ evidence.get("target") | tojson | forceescape }}"
                        aria-label="Open evidence {{ evidence_id }}"
                      >{{ evidence_id }}</button>
                    {% else %}
                      <span class="evidence-ref-unavailable">{{ evidence_id }} (target unavailable)</span>
                    {% endif %}
                    </li>
                  {% else %}
                    <li class="empty">No recorded evidence references.</li>
                  {% endfor %}
                  </ul>
                </div>
                <div class="verification-block">
                  <h4>Limitations</h4>
                  <ul class="finding-list">
                      {% for limitation in finding.get("limitations", []) %}
                    <li>{{ limitation }}</li>
                  {% else %}
                    <li class="empty">Complete evidence review unavailable.</li>
                  {% endfor %}
                  </ul>
                </div>
                <div class="verification-block">
                  <h4>Principles</h4>
                  <p class="empty">Unavailable: synthesis principles were not recorded.</p>
                </div>
                <div class="verification-block">
                  <h4>Counterevidence</h4>
                  <p class="empty">Unavailable: counterevidence was not recorded.</p>
                </div>
                <div class="verification-block">
                  <h4>Reviewer status</h4>
                  <p>Recorded finding; not reviewed by the complete evidence process.</p>
                </div>
              </div>
            </details>
          </article>
          {% endfor %}
        {% else %}
          {% for severity in ("critical", "high", "medium", "low") %}
            {% for finding in synthesis.findings if finding.severity == severity %}
              {{ render_finding(finding) }}
            {% endfor %}
          {% endfor %}
        {% endif %}
      {% else %}
      <p class="empty-conclusion">
        {% if synthesis_status == "no-issues" %}
        No supported UX issues were established in the tested scenarios.
        {% elif using_fallback %}
        No recorded findings are available for this report.
        {% else %}
        No accepted findings are available for this report.
        {% endif %}
      </p>
      {% endif %}
    </section>

    <section id="fix-first" class="report-section" aria-labelledby="fix-first-title">
      <div class="report-section-heading">
        <div>
          <p class="eyebrow">Action</p>
          <h2 id="fix-first-title">Fix first</h2>
        </div>
      </div>
      {% if synthesis.findings %}
      <ol class="fix-first-list">
        {% for severity in ("critical", "high", "medium", "low") %}
          {% for finding in synthesis.findings if finding.severity == severity %}
          <li>
            <a href="#finding-{{ finding.finding_id }}">
              <span class="severity-label severity-{{ finding.severity }}">{{ finding.severity | title }}</span>
              <strong>{{ finding.title }}</strong>
            </a>
                {% if finding.get("fixes") %}
                <span>{{ finding.fixes[0] }}</span>
                {% elif finding.get("cause") %}
                <span>Review recorded cause: {{ finding.get("cause") }}</span>
            {% endif %}
          </li>
          {% endfor %}
        {% endfor %}
      </ol>
      {% else %}
      <p class="empty-conclusion">No fix is prioritized because no supported issue was established in the tested scenarios.</p>
      {% endif %}
    </section>

    <section id="evidence-workspace" class="report-section evidence-navigation" aria-labelledby="evidence-workspace-title">
      <div class="report-section-heading">
        <div>
          <p class="eyebrow">Evidence</p>
          <h2 id="evidence-workspace-title">Evidence workspace</h2>
        </div>
        <span class="muted">Recorded detail and comparison</span>
      </div>
      <p>Use recorded evidence to verify a finding, compare runs, inspect saliency, or replay an interaction.</p>
      <nav class="evidence-nav" aria-label="Evidence sections">
        <a href="#comparison-overview" aria-controls="comparison-overview">Comparison table</a>
        {% if focused_acceptance %}
        <a href="#focused-acceptance" aria-controls="focused-acceptance">Saliency gate</a>
        {% endif %}
        {% if provider_comparisons %}
        <a href="#provider-comparison-section" aria-controls="provider-comparison-section">Provider methods</a>
        {% endif %}
        <a href="#playback-workspace" aria-controls="playback-workspace">Replay workspace</a>
        <a href="#report-limitations" aria-controls="report-limitations">Limitations</a>
      </nav>
    </section>

    <section id="comparison-overview" class="section evidence-panel overview-section" aria-labelledby="overview-title" aria-describedby="evidence-workspace-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Experiment</p>
          <h2 id="overview-title">Comparison overview</h2>
        </div>
        <div class="evidence-summary" aria-label="Evidence classes">
          {% for item in evidence_summary %}
          <span class="evidence-chip evidence-{{ item.evidence_class }}">
            {{ item.evidence_class }} <strong>{{ item.count }}</strong>
          </span>
          {% endfor %}
        </div>
      </div>
      <div class="table-wrap run-table-wrap">
        <table id="comparison-table">
          <thead>
            <tr>
              <th>Run</th>
              <th>Model trial</th>
              <th>Prominence provider</th>
              <th>Reproducibility</th>
              <th>Scenario</th>
              <th>Version</th>
              <th>Persona</th>
              <th>Policy</th>
              <th>User actions</th>
              <th>Observations</th>
              <th>Discovery cost <span class="subvalue">lower is better</span></th>
              <th>Estimated task time <span class="subvalue">simulated user effort</span></th>
              <th>Model calls <span class="subvalue">analysis cost</span></th>
              <th>Analysis latency</th>
              <th>Tokens</th>
              <th>Outcome</th>
              <th>Stage</th>
              <th>Verification</th>
              <th>Failure / evaluation reason</th>
              <th>Gate</th>
            </tr>
          </thead>
          <tbody>
          {% for row in run_rows %}
            <tr class="run-row {{ row.status_class }}" data-run-id="{{ row.run_id }}" tabindex="0" role="button" aria-label="Open run {{ row.run_id }}">
              <td><strong>{{ row.run_id }}</strong><span class="subvalue">{{ row.terminal_state }}</span></td>
              <td data-metric="model-trial">{{ row.model_trial }}</td>
              <td data-metric="prominence-provider">{{ row.prominence_provider_id }}</td>
              <td data-metric="reproducibility">{{ row.reproducibility_label }}</td>
              <td>{{ row.scenario_label }}</td>
              <td>{{ row.version_label }}</td>
              <td>{{ row.persona_label }}</td>
              <td>{{ row.policy }}</td>
              <td data-metric="user-actions">{{ row.user_actions }}</td>
              <td data-metric="observations">{{ row.observations }}</td>
              <td data-metric="discovery-cost">{{ row.discovery_cost if row.discovery_cost is not none else "unavailable" }}</td>
              <td data-metric="estimated-task-seconds">{{ row.estimated_task_seconds }}</td>
              <td data-metric="model-calls">{{ row.model_calls }}</td>
              <td data-metric="analysis-latency">{{ row.analysis_latency }}</td>
              <td data-metric="analysis-tokens">{{ row.analysis_tokens }}</td>
              <td><span class="status-pill">{{ row.outcome }}</span></td>
              <td>{{ row.stage }}</td>
              <td>{{ "verified" if row.verified else "not verified" }}</td>
              <td>{{ row.failure_reason }}</td>
              <td><strong>{{ row.gate_status }}</strong><span class="subvalue">{{ row.gate_reason }}</span></td>
            </tr>
          {% else %}
             <tr><td colspan="20">No run evidence recorded.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="method-note"><strong>simulated-task-time-v1:</strong> 1.35 seconds per observation plus 1.1 seconds per executed action. Analysis cost is not user effort. Monetary estimate unavailable unless explicit model pricing is configured.</p>

      <details class="aggregate-details">
        <summary>Aggregate comparison and directional gates</summary>
        <div class="aggregate-grid">
          <div class="table-wrap">
            <table id="aggregate-table">
             <thead><tr><th>Scenario</th><th>Persona</th><th>Policy</th><th>Prominence provider</th><th>Model trial</th><th>Reproducibility</th><th>Version</th><th>Runs</th><th>Verified</th><th>Discovery cost</th><th>Task seconds</th><th>Model calls</th><th>Latency ms</th><th>Tokens</th></tr></thead>
              <tbody>
              {% for row in comparison_rows %}
                 <tr><td>{{ row.scenario_label }}</td><td>{{ row.persona_label }}</td><td>{{ row.policy }}</td><td data-metric="prominence-provider">{{ row.prominence_provider_id }}</td><td data-metric="model-trial">{{ row.model_trial }}</td><td data-metric="reproducibility">{{ row.reproducibility_label }}</td><td>{{ row.version_label }}</td><td>{{ row.run_count }}</td><td>{{ "%.0f%%" | format(row.verified_rate * 100) }}</td><td>{{ row.discovery_cost if row.discovery_cost is not none else "unavailable" }}</td><td>{{ "%.1f" | format(row.estimated_task_seconds) if row.estimated_task_seconds is not none else "unavailable" }}</td><td>{{ "%.1f" | format(row.model_calls) if row.model_calls is not none else "unavailable" }}</td><td>{{ "%.0f" | format(row.analysis_latency_ms) if row.analysis_latency_ms is not none else "unavailable" }}</td><td>{{ "%.0f" | format(row.analysis_tokens) if row.analysis_tokens is not none else "unavailable" }}</td></tr>
              {% else %}
                 <tr><td colspan="14">Aggregate metrics unavailable.</td></tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="table-wrap">
            <table id="gate-table">
             <thead><tr><th>Scenario</th><th>Persona</th><th>Policy</th><th>Prominence provider</th><th>Model trial</th><th>Reproducibility</th><th>Seeds</th><th>Gate</th><th>Reason</th></tr></thead>
              <tbody>
              {% for row in gate_rows %}
                 <tr><td>{{ row.scenario_label }}</td><td>{{ row.persona_label }}</td><td>{{ row.policy }}</td><td data-metric="prominence-provider">{{ row.prominence_provider_id }}</td><td data-metric="model-trial">{{ row.model_trial }}</td><td data-metric="reproducibility">{{ row.reproducibility_label }}</td><td>{{ row.paired_seed_count }}</td><td>{{ "unavailable" if not row.available else "pass" if row.passed else "fail" }}</td><td>{{ row.reasons | join("; ") if row.reasons else "All directional checks passed" }}</td></tr>
              {% else %}
                 <tr><td colspan="9">Directional gates unavailable.</td></tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </details>
    </section>

    {% if focused_acceptance %}
    <section id="focused-acceptance" class="section evidence-panel focused-acceptance" aria-labelledby="focused-acceptance-title" aria-describedby="evidence-workspace-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Focused saliency validation</p>
          <h2 id="focused-acceptance-title">Focused saliency promotion gate</h2>
        </div>
        <strong>{{ "pass" if focused_acceptance.gate.passed else "fail" }}</strong>
      </div>
      <p>
        Cells: {{ focused_acceptance.gate.cell_count }};
        paired cells: {{ focused_acceptance.gate.paired_cell_count }};
        learned cells: {{ focused_acceptance.gate.learned_cell_count }}.
      </p>
      {% if focused_acceptance.gate.reasons %}
      <p>Gate reasons: {{ focused_acceptance.gate.reasons | join("; ") }}</p>
      {% endif %}
      <div class="table-wrap">
        <table id="focused-operational-evidence">
          <thead><tr><th>Scenario</th><th>Version</th><th>Provider</th><th>Status</th><th>Latency ms</th><th>Peak RSS bytes</th><th>Sampler</th><th>Synthetic</th></tr></thead>
          <tbody>
          {% for row in focused_acceptance.cells %}
            <tr><td>{{ row.scenario_id }}</td><td>{{ row.version_id }}</td><td>{{ row.provider_id }}</td><td>{{ row.status }}</td><td>{{ row.latency_ms }}</td><td>{{ row.peak_rss_bytes }}</td><td>{{ row.sampler_provider }}</td><td>{{ "yes" if row.synthetic else "no" }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="method-note"><strong>Operational evidence:</strong> promotion requires measured OS high-water latency and peak RSS. Synthetic fake measurements validate orchestration only.</p>
    </section>
    {% endif %}

    {% if provider_comparisons %}
    <style>
      .provider-comparison-section { padding: 18px; }
      .comparison-note { max-width: 460px; margin: 0; text-align: right; }
      .provider-comparison-toolbar { display: flex; flex-wrap: wrap; gap: 12px; margin: 14px 0; }
      .provider-comparison-toolbar label { display: grid; gap: 3px; color: var(--muted); font-size: .7rem; }
      .provider-comparison-output { min-width: 0; }
      .comparison-cell-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 8px 0 12px; }
      .comparison-cell-heading h3 { margin: 0; font-size: 1rem; }
      .comparison-cell-heading p { margin: 0; }
      .provider-comparison-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
      .provider-card { min-width: 0; padding: 14px; border: 1px solid var(--line); border-top: 4px solid var(--accent); border-radius: 5px; background: var(--panel); }
      .provider-card-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
      .provider-card-heading h3 { margin: 0; font-size: 1rem; }
      .provider-status { padding: 3px 6px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted); font-size: .68rem; font-weight: 800; }
      .comparison-block { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); }
      .comparison-block > strong { display: block; margin-bottom: 6px; font-size: .76rem; }
      .provider-heatmap { display: block; width: min(100%, 420px); max-height: 260px; margin: 8px 0; border: 1px solid var(--line); image-rendering: auto; object-fit: contain; background: #17222a; }
      .exact-heatmap { image-rendering: pixelated; }
      .artifact-link { display: inline-block; margin: 2px 0; color: var(--accent); font-size: .74rem; font-weight: 750; overflow-wrap: anywhere; }
      .comparison-ranking-table { margin-top: 8px; }
      .comparison-path { display: grid; gap: 6px; margin: 0; padding-left: 22px; }
      .comparison-path li { padding-left: 2px; font-size: .73rem; }
      .path-step { max-width: 100%; padding: 4px 6px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); color: var(--ink); text-align: left; font-size: .72rem; overflow-wrap: anywhere; }
      .path-step:hover, .path-step:focus-visible { border-color: var(--accent); background: var(--accent-soft); }
      .path-status { margin-left: 6px; font-size: .68rem; font-weight: 800; text-transform: uppercase; }
      .path-status-succeeded { color: var(--success); }
      .path-status-failed { color: var(--danger); }
      .path-status-recorded { color: var(--muted); }
      .path-error { display: block; margin: 3px 0 0 6px; color: var(--danger); font-size: .68rem; overflow-wrap: anywhere; }
      @media (max-width: 760px) {
        .provider-comparison-grid { grid-template-columns: 1fr; }
        .comparison-note { text-align: left; }
        .comparison-cell-heading { align-items: flex-start; flex-direction: column; }
      }
    </style>
    <section id="provider-comparison-section" class="section evidence-panel provider-comparison-section" aria-labelledby="provider-comparison-title" aria-describedby="evidence-workspace-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Methods</p>
          <h2 id="provider-comparison-title">Provider method comparison</h2>
        </div>
        <p class="method-note comparison-note">Exact persisted heatmaps, prominence rankings, and executed action paths.</p>
      </div>
      <div class="provider-comparison-toolbar">
        <label>Paired cell<select id="provider-comparison-select"></select></label>
        <label>Foveacast duration<select id="provider-comparison-duration"></select></label>
      </div>
      <div id="provider-comparison-output" class="provider-comparison-output"></div>
    </section>
    {% endif %}

    <section class="section evidence-panel workspace-shell" id="playback-workspace" aria-labelledby="workspace-title" aria-describedby="evidence-workspace-title">
      <div class="workspace-heading">
        <div>
          <p class="eyebrow">Playback</p>
          <h2 id="workspace-title">Run workspace</h2>
        </div>
        <div class="selector-group">
          <label>Scenario<select id="scenario-select"><option value="">All scenarios</option></select></label>
          <label>Run<select id="run-select"></select></label>
        </div>
      </div>

      <div class="playback-toolbar" aria-label="Playback controls">
        <button id="restart-playback" class="icon-button" type="button" title="Restart playback" aria-label="Restart playback">&#8635;</button>
        <button id="step-back" class="icon-button" type="button" title="Previous recorded event" aria-label="Previous recorded event">&#8592;</button>
        <button id="play-pause" class="play-button" type="button" aria-pressed="false"><span class="play-icon" aria-hidden="true">&#9654;</span><span id="play-label">Play</span></button>
        <button id="step-forward" class="icon-button" type="button" title="Next recorded event" aria-label="Next recorded event">&#8594;</button>
        <input id="playback-progress" type="range" min="0" max="0" value="0" aria-label="Recorded event progress">
        <output id="playback-position">Step 0 / 0 | time unavailable</output>
      </div>

      <div id="run-status-banner" class="run-status-banner status-untrusted" role="status">Run unavailable.</div>

      <div class="workspace-grid">
        <section class="viewport-pane" aria-labelledby="viewport-title">
          <div class="pane-heading">
            <h3 id="viewport-title">Recorded viewport</h3>
            <span id="viewport-meta">Unavailable</span>
          </div>
          <div id="viewport-stage" class="viewport-stage"></div>
        </section>

        <section class="event-pane" aria-labelledby="event-title">
          <div class="pane-heading">
            <h3 id="event-title">Current event</h3>
            <span id="event-kind">Unavailable</span>
          </div>
          <article id="current-event-card" class="current-event-card"></article>
        </section>

        <aside id="selected-element-evidence" class="element-pane" aria-labelledby="element-title">
           <div class="pane-heading">
             <h3 id="element-title">Element evidence</h3>
             <span id="element-state">Paused</span>
           </div>
           <div id="element-detail"></div>
           <section id="saliency-evidence" class="saliency-evidence" aria-labelledby="saliency-title">
             <div class="pane-heading">
               <h3 id="saliency-title">Saliency evidence</h3>
               <span id="saliency-runtime-label">Unavailable</span>
             </div>
             <div id="saliency-tabs" class="saliency-tabs" role="tablist" aria-label="Saliency duration"></div>
             <div id="saliency-detail"></div>
           </section>
         </aside>
      </div>

      <div class="timeline-rail" aria-labelledby="timeline-title">
        <div class="pane-heading">
          <h3 id="timeline-title">Recorded timeline</h3>
          <span id="timeline-count">0 events</span>
        </div>
        <ol id="timeline-list" class="timeline-list"></ol>
      </div>
    </section>

    <details id="report-limitations" class="section evidence-panel limitations">
      <summary>Trust boundaries and limitations</summary>
      <ul>
      {% for limitation in limitations %}
        <li>{{ limitation }}</li>
      {% endfor %}
      </ul>
      <p class="muted"><strong>deterministic-fact</strong> records measured interface, action, geometry, bundle, or verifier state. <strong>model-estimate</strong> depends on configured heuristic, scent, policy, persona, memory, rule, or model behavior. Unsupported human claims never enter scorecards or findings.</p>
    </details>
  </main>

  <script type="application/json" id="report-data">{{ report_json | safe }}</script>
  <script>
  {% if compact_index %}
  (function () {
    document.querySelectorAll(".evidence-ref").forEach(function (control) {
      control.addEventListener("click", function () {
        var target = {};
        try { target = JSON.parse(control.dataset.evidenceTarget || "{}"); }
        catch (_error) { return; }
        if (!target.run_page) return;
        var hash = new URLSearchParams();
        if (target.run_id) hash.set("run", target.run_id);
        if (target.event_id) hash.set("event", target.event_id);
        else if (target.sequence !== undefined) hash.set("event", "event-" + target.sequence);
        if (target.element_id) hash.set("element", target.element_id);
        window.location.href = target.run_page + "#" + hash.toString();
      });
    });
  }());
  {% else %}
  {{ javascript | safe }}
  {% endif %}
  </script>
</body>
</html>
