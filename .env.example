UXA_LLM_MODE=api
UXA_LLM_BASE_URL=https://<provider-host>/v1
UXA_LLM_API_KEY=<api-key>
UXA_SCENT_MODEL=<scent-model-id>
UXA_COGNITIVE_MODEL=<cognitive-model-id>
# Required when report synthesis is enabled.
# UXA_REPORT_MODEL=<report-model-id>
# Optional scent effort: none, minimal, low, medium, high, xhigh, or max.
UXA_LLM_SCENT_REASONING_EFFORT=
# Optional cognitive effort: none, minimal, low, medium, high, xhigh, or max.
UXA_LLM_COGNITIVE_REASONING_EFFORT=
# Optional report-synthesis effort: none, minimal, low, medium, high, xhigh, or max.
# UXA_LLM_REPORT_REASONING_EFFORT=
# Positive seconds; use `none` for long-running Codex calls only.
UXA_LLM_TIMEOUT_SECONDS=30
UXA_LLM_MAX_CONCURRENT_CALLS=2
UXA_RUN_LIVE_TESTS=0
