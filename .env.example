UXA_LLM_MODE=api
UXA_LLM_BASE_URL=https://<provider-host>/v1
UXA_LLM_API_KEY=<api-key>
# Optional Google Cloud API key for PageSpeed Insights (PageSpeed Insights API
# enabled). Used by `uxa run` and `uxa pagespeed` to fetch Lighthouse reports
# from https://www.googleapis.com/pagespeedonline/v5/runPagespeed. Without a
# key the shared unauthenticated quota is often exhausted (HTTP 429).
PSI_API_Key=<google-api-key>
UXA_SCENT_MODEL=<scent-model-id>
UXA_COGNITIVE_MODEL=<cognitive-model-id>
# Required for live report synthesis when the project enables it. The report
# model must support structured JSON and image input for screenshot or heatmap
# evidence; one model may serve all four isolated report roles.
# UXA_REPORT_MODEL=<report-model-id>
# Optional scent effort: none, minimal, low, medium, high, xhigh, or max.
UXA_LLM_SCENT_REASONING_EFFORT=
# Optional cognitive effort: none, minimal, low, medium, high, xhigh, or max.
UXA_LLM_COGNITIVE_REASONING_EFFORT=
# Optional report-synthesis effort: none, minimal, low, medium, high, xhigh, or max.
# UXA_LLM_REPORT_REASONING_EFFORT=
# Positive seconds; use `none` for no model-call timeout.
UXA_LLM_TIMEOUT_SECONDS=30
UXA_LLM_MAX_CONCURRENT_CALLS=2
UXA_RUN_LIVE_TESTS=0
